{
  "expo": {
    "name": "SignBridge",
    "slug": "signbridge",
    "scheme": "signbridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B132B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signbridge.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SignBridge uses the camera to detect and translate sign language in real time.",
        "NSMicrophoneUsageDescription": "SignBridge uses the microphone to capture your voice so it can be translated into sign language.",
        "NSSpeechRecognitionUsageDescription": "SignBridge transcribes your speech to translate it into sign language."
      }
    },
    "android": {
      "package": "com.signbridge.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B132B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SignBridge needs camera access to detect sign language."
        }
      ]
    ]
  }
}
